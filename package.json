{
  "name": "perch-studio",
  "version": "0.1.0",
  "description": "Perch: tree-based cockpit for the Pi coding agent.",
  "main": "out/main/index.js",
  "author": "Perch",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/tspen/perch.git"
  },
  "homepage": "https://github.com/tspen/perch#readme",
  "bugs": {
    "url": "https://github.com/tspen/perch/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:mobile && npm run build:runner",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --win dir",
    "test": "vitest run",
    "smoke": "npm run build && electron . --smoke-test",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:android": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "build:runner": "tsc -p tsconfig.runner.json",
    "perf:remote": "node scripts/remote-perf.mjs",
    "runner:gc": "node out/runner/cli/runner.js gc --dry-run",
    "runner:quota": "node out/runner/cli/runner.js quota",
    "test:gc": "node scripts/gc-selftest.mjs",
    "pi:selftest": "node scripts/pi-engine-selftest.mjs",
    "pi:durable": "node scripts/pi-durable-selftest.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^9.0.0",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.72.0",
    "node-pty": "^1.1.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript-language-server": "^6.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@earendil-works/chord": "^1.5.2",
    "@earendil-works/pi-durable": "^1.5.2",
    "@types/node": "^26.6.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
